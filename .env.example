# Run-summary email, sent by autopilot_notify.py when a run ends (finished,
# stopped for review, or interrupted). Applies to every project you run
# autopilot in — this is a one-time setup, not per-project config.
#
# Copy this file to .env in this repo (not in any project you run autopilot
# against). Unset or false means autopilot sends nothing; a send failure
# never fails the run.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587                # 465 switches to implicit SSL; anything else uses STARTTLS
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=                    # comma-separated
